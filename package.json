{
  "name": "wacrm",
  "version": "0.7.0",
  "private": true,
  "description": "Self-hostable CRM template for WhatsApp built on Next.js and Supabase — shared inbox, contacts, sales pipelines, broadcasts, and no-code automations.",
  "license": "MIT",
  "author": "Arnas Donauskas",
  "homepage": "https://github.com/ArnasDon/wacrm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArnasDon/wacrm.git"
  },
  "bugs": {
    "url": "https://github.com/ArnasDon/wacrm/issues"
  },
  "keywords": [
    "crm",
    "whatsapp",
    "whatsapp-business-api",
    "nextjs",
    "supabase",
    "automation",
    "broadcast",
    "self-hosted",
    "template"
  ],
  "engines": {
    "node": ">=22.0.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev-with-whatsapp.mjs",
    "dev:next": "next dev",
    "dev:web": "node services/whatsapp-web-worker.mjs",
    "build": "next build",
    "start": "node scripts/start-with-whatsapp.mjs",
    "start:next": "next start",
    "start:web": "node services/whatsapp-web-worker.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy:check": "node scripts/check-production-readiness.mjs",
    "check:mobile": "node scripts/check-mobile-responsive.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dagrejs/dagre": "^3.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.107.0",
    "@xyflow/react": "^12.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.22.0",
    "next": "16.3.6",
    "opus-recorder": "^8.0.5",
    "puppeteer": "^25.8.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.9.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn": "^4.21.0",
    "supabase": "^2.109.1",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "postcss": "^8.5.26",
    "ip-address": "^10.5.0",
    "baseline-browser-mapping": "^2.11.25",
    "browserslist": "^4.29.0",
    "fast-uri": "^3.1.8",
    "hono": "^4.13.8",
    "js-yaml": "^4.3.2",
    "minimatch@<=9.0.9": {
      "brace-expansion": "2.1.4"
    },
    "minimatch@>=10": {
      "brace-expansion": "5.0.9"
    },
    "nanoid": "^3.3.18",
    "postcss-selector-parser": "^7.1.6",
    "qs": "^6.16.0",
    "sharp": "^0.35.4",
    "@hono/node-server": "^1.19.15",
    "body-parser": "^2.3.0",
    "whatsapp-web.js": {
      "puppeteer": "^25.8.0"
    },
    "@babel/core": "^7.29.6"
  }
}
