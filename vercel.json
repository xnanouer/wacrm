{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/automations/cron",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/flows/cron",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/quotes/retention",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/platform/storage/monitor",
      "schedule": "15 6 * * *"
    }
  ]
}
